# 이 파일을 backend/.env 로 복사한 뒤 값을 채운다:  Copy-Item .env.example .env
# .env 는 .gitignore 에 포함되어 커밋되지 않는다. API 키를 코드나 프론트엔드에 넣지 않는다.

# true 이면 모든 LLM 호출이 MockProvider 로 간다 (API 키 불필요)
MOCK_MODE=true

# 답변 생성용 제공자: anthropic | openai | elice(미구현)
GENERATOR_PROVIDER=anthropic
GENERATOR_MODEL=claude-sonnet-5-5
# 가드레일 판정·질의 재작성용 제공자
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-5-5
# 제공자가 openai 일 때 사용할 GPT 모델명
OPENAI_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 응답 모드: direct | hint | adaptive
ANSWER_MODE=adaptive
# 근거 모드: general(일반 지식) | kb(교육 자료 근거)
GROUNDING_MODE=general
# 가드 프로필: none | default | member_a | member_b | member_c | member_d
GUARD_PROFILE=none

MAX_MESSAGE_CHARS=2000
MAX_TURNS=20
# 요청 본문 최대 크기 (bytes). 대화 이력 전체가 매 요청에 실리므로 넉넉히 둔다.
MAX_REQUEST_BYTES=524288
# 쉼표로 여러 개 지정 가능
CORS_ORIGINS=http://localhost:5173

# ---- 선택 항목 (optional) ----
# Anthropic effort (low | medium | high | xhigh | max). 비우면 보내지 않는다 (모델 기본값 사용).
GENERATOR_EFFORT=low
JUDGE_EFFORT=low
# Anthropic 서버측 refusal fallback (default | off). 지원 모델(Sonnet 5.5, Opus 5.x)에서만 적용된다.
ANTHROPIC_REFUSAL_FALLBACK=default
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# true 이면 BM25 + dense 임베딩 하이브리드 검색 (requirements-optional.txt 설치 필요)
HYBRID_SEARCH=false
# 교육 자료 폴더와 인덱스 파일 경로 (backend/ 기준 상대경로)
KB_DIR=data/sample/kb
KB_INDEX_PATH=data/index/kb_index.json
LOG_LEVEL=INFO
# false 이면 logs/turns_*.jsonl 턴 로그를 남기지 않는다
LOG_TURNS=true

# 엘리스 ML API (대회 환경 공개 후 연결 — 현재 미구현)
ELICE_API_BASE=
ELICE_API_KEY=
